# Gabarit du .env de production. A renommer en .env sur le serveur.
# Voir docs/DEPLOIEMENT.md, etape 3.
#
# Ce fichier est un gabarit : il ne doit jamais contenir de vraie valeur.

APP_NAME=ESCAT
APP_ENV=production

# php artisan key:generate --show, sur le poste de travail.
# Une cle propre a la production : elle chiffre sessions et cookies.
APP_KEY=

# A laisser a false. A true, la moindre erreur affiche le code source,
# les requetes et les identifiants de la base.
APP_DEBUG=false

APP_URL=https://www.escat.cg

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# daily plutot que single : un mutualise a un quota de disque, et un
# journal unique grossit sans fin.
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Les trois valeurs viennent de cPanel > MySQL Databases. Chez la plupart
# des hebergeurs, le nom reel est prefixe par le compte :
# moncompte_escat_prod.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Le domaine servi, point initial compris, pour couvrir les sous-domaines.
SESSION_DOMAIN=.escat.cg
# Les cookies ne partent qu'en HTTPS.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

# database, et non sync : l'envoi d'un courriel ne doit pas faire attendre
# la personne qui vient de remplir le formulaire. Demande toutefois un
# `php artisan queue:work` cote serveur ; a defaut, mettre sync.
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Compte SMTP cree dans cPanel > Email Accounts.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.escat.cg
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="contact@escat.cg"
MAIL_FROM_NAME="${APP_NAME}"

# Destinataire des demandes du formulaire de contact.
MAIL_CONTACT_RECIPIENT=

VITE_APP_NAME="${APP_NAME}"

SOCIAL_FACEBOOK=
SOCIAL_LINKEDIN=
SOCIAL_INSTAGRAM=
SOCIAL_TIKTOK=
SOCIAL_YOUTUBE=
